{
  "name": "git-blame-annotate",
  "displayName": "Git Blame Annotate",
  "description": "行首 Blame 热力色条；编辑时保持显示，保存后刷新；悬停出行首 Git 信息",
  "version": "0.3.19",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gitBlameAnnotate.toggle",
    "onCommand:gitBlameAnnotate.hide"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitBlameAnnotate.toggle",
        "title": "切换 Git Blame 注解",
        "category": "Git Blame 注解"
      },
      {
        "command": "gitBlameAnnotate.hide",
        "title": "隐藏 Git Blame 注解",
        "category": "Git Blame 注解"
      }
    ],
    "menus": {
      "editor/lineNumber/context": [
        {
          "command": "gitBlameAnnotate.toggle",
          "group": "navigation@1",
          "when": "!gitBlameAnnotate.active"
        },
        {
          "command": "gitBlameAnnotate.hide",
          "group": "navigation@1",
          "when": "gitBlameAnnotate.active"
        }
      ],
      "editor/context": [
        {
          "command": "gitBlameAnnotate.toggle",
          "group": "scm@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
